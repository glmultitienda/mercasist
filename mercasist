<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MercaSist ML Engine - Gestor de Mercado Libre</title>
  <script src="https://unpkg.com/react@18/umd/react.production.min.js" crossorigin></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js" crossorigin></script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { font-family: system-ui, -apple-system, sans-serif; background-color: #f3f4f6; }
  </style>
</head>
<body>
  <div id="root"></div>
  <script type="text/babel">
    const { useState } = React;

    function App() {
      const [activeTab, setActiveTab] = useState('inventory');
      const [isConnected, setIsConnected] = useState(false);
      const [appId, setAppId] = useState('8473920194837261');
      const [secretKey, setSecretKey] = useState('••••••••••••••••••••••••');
      const [accessToken, setAccessToken] = useState('');
      const [apiLogs, setApiLogs] = useState([]);
      
      const [items, setItems] = useState([
        { id: 'MLA-14283948', sku: 'INJ-VW-GOL16', title: 'Inyector De Gasolina VW Gol Power 1.6 Mi AP (4 Boquillas)', price: 18.50, stock: 24, status: 'active', category: 'Inyectores' },
        { id: 'MLA-14920482', sku: 'SEN-O2-FOX16', title: 'Sensor De Oxígeno Lambda Volkswagen Fox / Crossfox 1.6', price: 28.00, stock: 12, status: 'active', category: 'Sensores' },
        { id: 'MLA-15029384', sku: 'BUJ-NGK-PALIO', title: 'Juego De Bujías NGK Fiat Palio / Siena Fire 1.3 16v', price: 14.20, stock: 5, status: 'paused', category: 'Encendido' },
        { id: 'MLA-15930294', sku: 'BOB-IND-GOL', title: 'Bobina De Encendido 4 Pines VW Gol Trend / Voyage 1.6', price: 35.00, stock: 8, status: 'active', category: 'Encendido' }
      ]);

      const [selectedItems, setSelectedItems] = useState([]);
      const [showBulkModal, setShowBulkModal] = useState(false);
      const [priceChangeType, setPriceChangeType] = useState('percent_inc');
      const [priceValue, setPriceValue] = useState(10);

      const addLog = (method, endpoint, status) => {
        setApiLogs(prev => [{ time: new Date().toLocaleTimeString(), method, endpoint, status }, ...prev.slice(0, 9)]);
      };

      const handleConnect = () => {
        addLog('POST', 'https://api.mercadolibre.com/oauth/token', 200);
        setIsConnected(true);
        setAccessToken('APP_USR-8473920194837261-110809-a7c8b9d0e1f2-10928374');
      };

      const toggleSelectAll = () => {
        if (selectedItems.length === items.length) {
          setSelectedItems([]);
        } else {
          setSelectedItems(items.map(i => i.id));
        }
      };

      const toggleSelectItem = (id) => {
        setSelectedItems(prev => prev.includes(id) ? prev.filter(item => item !== id) : [...prev, id]);
      };

      const applyBulkChange = () => {
        setItems(prev => prev.map(item => {
          if (!selectedItems.includes(item.id)) return item;
          let newPrice = item.price;
          const val = parseFloat(priceValue) || 0;
          if (priceChangeType === 'percent_inc') newPrice = item.price * (1 + val / 100);
          if (priceChangeType === 'percent_dec') newPrice = item.price * (1 - val / 100);
          if (priceChangeType === 'fixed') newPrice = val;
          return { ...item, price: parseFloat(newPrice.toFixed(2)) };
        }));
        addLog('PUT', `/items/batch (Modificados: ${selectedItems.length})`, 200);
        setShowBulkModal(false);
        setSelectedItems([]);
      };

      return (
        <div className="min-h-screen flex flex-col">
          <header className="bg-yellow-400 text-gray-900 px-6 py-4 flex justify-between items-center shadow-md">
            <div className="flex items-center gap-3">
              <div className="bg-gray-900 text-yellow-400 p-2 rounded-lg font-bold text-xl">MS</div>
              <div>
                <h1 className="font-extrabold text-xl leading-tight">MercaSist ML Engine</h1>
                <p className="text-xs font-semibold text-gray-800">Panel de Control de Publicaciones API Mercado Libre</p>
              </div>
            </div>
            <span className={`px-3 py-1 rounded-full text-xs font-bold flex items-center gap-1.5 ${isConnected ? 'bg-green-800 text-white' : 'bg-red-800 text-white'}`}>
              <span className={`w-2 h-2 rounded-full ${isConnected ? 'bg-green-400 animate-pulse' : 'bg-red-400'}`}></span>
              {isConnected ? 'API Conectada' : 'API Desconectada'}
            </span>
          </header>

          <div className="flex flex-1">
            <aside className="w-64 bg-gray-900 text-gray-300 p-4 space-y-2">
              <button onClick={() => setActiveTab('inventory')} className={`w-full text-left px-4 py-3 rounded-lg flex items-center gap-3 text-sm font-medium transition ${activeTab === 'inventory' ? 'bg-yellow-400 text-gray-900 font-bold' : 'hover:bg-gray-800'}`}>📦 Publicaciones (Items)</button>
              <button onClick={() => setActiveTab('connection')} className={`w-full text-left px-4 py-3 rounded-lg flex items-center gap-3 text-sm font-medium transition ${activeTab === 'connection' ? 'bg-yellow-400 text-gray-900 font-bold' : 'hover:bg-gray-800'}`}>🔑 Conexión API (OAuth 2.0)</button>
              <button onClick={() => setActiveTab('qa')} className={`w-full text-left px-4 py-3 rounded-lg flex items-center gap-3 text-sm font-medium transition ${activeTab === 'qa' ? 'bg-yellow-400 text-gray-900 font-bold' : 'hover:bg-gray-800'}`}>💬 Preguntas & Respuestas</button>
            </aside>

            <main className="flex-1 p-6">
              {activeTab === 'inventory' && (
                <div className="space-y-6">
                  <div className="bg-white p-4 rounded-xl shadow-sm border border-gray-200 flex justify-between items-center">
                    <div>
                      <h2 className="text-lg font-bold text-gray-800">Publicaciones Sincronizadas</h2>
                      <p className="text-xs text-gray-500">Gestión directa sobre tus items de Mercado Libre</p>
                    </div>
                    {selectedItems.length > 0 && (
                      <button onClick={() => setShowBulkModal(true)} className="bg-green-600 hover:bg-green-700 text-white font-bold px-4 py-2 rounded-lg text-sm shadow transition">
                        ⚡ Acción Masiva ({selectedItems.length})
                      </button>
                    )}
                  </div>
                  <div className="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                    <table className="w-full text-left text-sm">
                      <thead className="bg-gray-50 border-b border-gray-200 text-gray-600 uppercase text-xs">
                        <tr>
                          <th className="p-4 w-10"><input type="checkbox" checked={selectedItems.length === items.length} onChange={toggleSelectAll} /></th>
                          <th className="p-4">SKU / Item ID</th>
                          <th className="p-4">Título del Producto</th>
                          <th className="p-4">Categoría</th>
                          <th className="p-4">Precio ($)</th>
                          <th className="p-4">Stock</th>
                          <th className="p-4">Estado</th>
                        </tr>
                      </thead>
                      <tbody className="divide-y divide-gray-100">
                        {items.map(item => (
                          <tr key={item.id} className="hover:bg-gray-50 transition">
                            <td className="p-4"><input type="checkbox" checked={selectedItems.includes(item.id)} onChange={() => toggleSelectItem(item.id)} /></td>
                            <td className="p-4"><div className="font-mono text-xs font-bold text-gray-700">{item.sku}</div><div className="text-[10px] text-blue-600">{item.id}</div></td>
                            <td className="p-4 font-medium text-gray-800">{item.title}</td>
                            <td className="p-4 text-xs text-gray-500">{item.category}</td>
                            <td className="p-4 font-bold text-gray-900">${item.price.toFixed(2)}</td>
                            <td className="p-4"><span className={`px-2 py-0.5 rounded text-xs font-bold ${item.stock <= 5 ? 'bg-red-100 text-red-700' : 'bg-gray-100 text-gray-700'}`}>{item.stock} uds</span></td>
                            <td className="p-4"><span className={`px-2.5 py-1 rounded-full text-[11px] font-bold ${item.status === 'active' ? 'bg-green-100 text-green-700' : 'bg-yellow-100 text-yellow-700'}`}>{item.status === 'active' ? 'Activo' : 'Pausado'}</span></td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>
              )}

              {activeTab === 'connection' && (
                <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <div className="bg-white p-6 rounded-xl shadow-sm border border-gray-200 space-y-4">
                    <h3 className="text-lg font-bold text-gray-800 border-b pb-2">Configuración de credenciales API</h3>
                    <div>
                      <label className="block text-xs font-bold text-gray-600 uppercase mb-1">App ID / Client ID</label>
                      <input type="text" value={appId} onChange={(e) => setAppId(e.target.value)} className="w-full border p-2.5 rounded-lg text-sm font-mono bg-gray-50" />
                    </div>
                    <div>
                      <label className="block text-xs font-bold text-gray-600 uppercase mb-1">Secret Key / Client Secret</label>
                      <input type="password" value={secretKey} onChange={(e) => setSecretKey(e.target.value)} className="w-full border p-2.5 rounded-lg text-sm font-mono bg-gray-50" />
                    </div>
                    <button onClick={handleConnect} className="w-full bg-yellow-400 hover:bg-yellow-500 font-bold text-gray-900 py-3 rounded-lg transition shadow">
                      {isConnected ? 'Re-Autenticar con Mercado Libre' : 'Conectar con Mercado Libre (OAuth 2.0)'}
                    </button>
                    {accessToken && (
                      <div className="mt-4 p-3 bg-gray-900 text-green-400 rounded-lg text-xs font-mono break-all">
                        <span className="text-gray-400 block font-sans text-[10px] uppercase font-bold">Access Token Activo:</span>
                        {accessToken}
                      </div>
                    )}
                  </div>

                  <div className="bg-gray-900 text-gray-200 p-6 rounded-xl shadow-sm space-y-4 flex flex-col">
                    <h3 className="text-lg font-bold text-white border-b border-gray-800 pb-2">📡 Monitor de Peticiones HTTP</h3>
                    <div className="flex-1 space-y-2 font-mono text-xs overflow-y-auto max-h-[300px]">
                      {apiLogs.length === 0 ? <p className="text-gray-500 italic">No hay solicitudes registradas aún...</p> : apiLogs.map((log, index) => (
                        <div key={index} className="p-2 rounded bg-gray-800 flex justify-between items-center">
                          <div><span className="text-yellow-400 font-bold mr-2">[{log.method}]</span><span className="text-gray-300">{log.endpoint}</span></div>
                          <span className="text-green-400 text-[10px] bg-green-950 px-1.5 py-0.5 rounded">{log.status} OK</span>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              )}

              {activeTab === 'qa' && (
                <div className="bg-white p-6 rounded-xl shadow-sm border border-gray-200">
                  <h3 className="text-lg font-bold text-gray-800 mb-4">Gestor de Preguntas Entrantes</h3>
                  <div className="space-y-4">
                    <div className="p-4 bg-gray-50 rounded-lg border border-gray-200">
                      <div className="flex justify-between items-center mb-2">
                        <span className="font-bold text-xs text-blue-600">En publicación: INJ-VW-GOL16</span>
                        <span className="text-xs text-gray-400">Hace 5 min</span>
                      </div>
                      <p className="text-sm font-semibold text-gray-800 mb-3">"¿Hola amigo! ¿Este inyector le sirve a un VW Gol Power 2008 motor 1.6 AP?"</p>
                      <div className="flex gap-2">
                        <input type="text" placeholder="Escribe tu respuesta..." className="flex-1 border p-2 rounded-lg text-sm" />
                        <button className="bg-yellow-400 hover:bg-yellow-500 text-gray-900 font-bold px-4 py-2 rounded-lg text-sm">Responder</button>
                      </div>
                    </div>
                  </div>
                </div>
              )}
            </main>
          </div>

          {showBulkModal && (
            <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4">
              <div className="bg-white rounded-xl shadow-xl max-w-md w-full p-6 space-y-4">
                <h3 className="text-lg font-bold text-gray-800">Acción Masiva en {selectedItems.length} Publicaciones</h3>
                <div>
                  <label className="block text-xs font-bold text-gray-600 mb-1">Tipo de Ajuste de Precio</label>
                  <select value={priceChangeType} onChange={(e) => setPriceChangeType(e.target.value)} className="w-full border p-2 rounded-lg text-sm">
                    <option value="percent_inc">Aumentar por Porcentaje (%)</option>
                    <option value="percent_dec">Disminuir por Porcentaje (%)</option>
                    <option value="fixed">Fijar Precio Fijo ($)</option>
                  </select>
                </div>
                <div>
                  <label className="block text-xs font-bold text-gray-600 mb-1">Valor</label>
                  <input type="number" value={priceValue} onChange={(e) => setPriceValue(e.target.value)} className="w-full border p-2 rounded-lg text-sm" />
                </div>
                <div className="flex justify-end gap-3 pt-4 border-t">
                  <button onClick={() => setShowBulkModal(false)} className="px-4 py-2 border rounded-lg text-sm font-semibold text-gray-600 hover:bg-gray-50">Cancelar</button>
                  <button onClick={applyBulkChange} className="px-4 py-2 bg-green-600 hover:bg-green-700 text-white rounded-lg text-sm font-bold shadow">Aplicar a Todos</button>
                </div>
              </div>
            </div>
          )}
        </div>
      );
    }
    ReactDOM.render(<App />, document.getElementById('root'));
  </script>
</body>
</html>
